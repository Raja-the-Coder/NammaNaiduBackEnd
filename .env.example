# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_NAME=namma_naidu
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ─── Fast2SMS (WhatsApp OTP via BSP) ───
# Fast2SMS acts as a WhatsApp BSP (Business Solution Provider) with an approved number.
# Step 1: Create account at https://www.fast2sms.com
# Step 2: Enable WhatsApp Business API from the dashboard
# Step 3: Create & get OTP template approved (template name: otp_verification)
# Step 4: Copy your API key from the Fast2SMS dashboard
FAST2SMS_API_KEY=your-fast2sms-api-key-here
FAST2SMS_OTP_TEMPLATE_NAME=otp_verification
FAST2SMS_OTP_TEMPLATE_LANGUAGE=en

# ─── MSG91 SMS / OTP Configuration (legacy - no longer used) ───
# MSG91_AUTH_KEY=your-msg91-auth-key-here
# MSG91_OTP_TEMPLATE_ID=your-otp-template-id-here
# MSG91_OTP_LENGTH=6
# MSG91_OTP_EXPIRY_MINUTES=10

# ─── OTP Security Settings ───
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ─── Email OTP Providers (choose one) ───
# SendGrid (recommended for Render/Vercel)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@nammanaidu.com

# Resend (recommended for Railway/VPS)
# RESEND_API_KEY=your-resend-api-key

# SMTP (Gmail / custom SMTP)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# ─── Cloudinary (Image uploads) ───
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ─── Firebase (Push notifications & phone auth) ───
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ─── Stream Chat (real-time messaging) ───
# STREAM_CHAT_API_KEY=
# STREAM_CHAT_API_SECRET=

# ─── PayU (Primary Payment Gateway) ───
# Dashboard: https://onboardinguat.payu.in/merchant-panel/developer/apikeys
# Test Mode: MID 9191388, key gwCiz1
# Production: Switch to live key/salt from PayU dashboard
PAYU_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-salt


